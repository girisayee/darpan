# Copy to .env.local and fill in. Never commit real secrets.

# Postgres connection string
DATABASE_URL=postgres://darpan:darpan@localhost:5432/darpan

# Auth.js — generate AUTH_SECRET with `npx auth secret`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Benchmark index data (Alpha Vantage)
ALPHAVANTAGE_API_KEY=

# Phase B (admin) — single non-SSO admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_HASH=   # bcrypt hash
